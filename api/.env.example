# SendGrid Configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@pizzapohoda.sk

# Restaurant Contact Info
VITE_RESTAURANT_EMAIL=objednavky@pizzapohoda.sk
VITE_RESTAURANT_PHONE=+421918175571

# Server Configuration
PORT=3001

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@pizzapohoda-analytics.h7bu7up.mongodb.net/?appName=PizzaPohoda-analytics

# RabbitMQ
RABBITMQ_URL=amqp://username:password@localhost:5672

# Admin authentication
# JWT_SECRET signs the admin session cookie — generate with:
#   openssl rand -hex 48
# If unset the server falls back to a random per-boot secret, which logs
# everyone out on every restart.
JWT_SECRET=

# Seeds the first admin account when the users collection is empty. Ignored
# once at least one user exists — change passwords in the admin, not here.
ADMIN_USERNAME=marciAdmin
ADMIN_PASSWORD=LucenecJeSuper123

# Comma-separated; only needed if the storefront runs on another origin.
# ALLOWED_ORIGINS=https://pizzapohoda.sk,https://pizzapohoda.pl
