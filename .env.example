
VITE_RESTAURANT_EMAIL=objednavky@pizzapohoda.sk
VITE_RESTAURANT_PHONE=+421 918 175 571

# Production: leave empty so the frontend calls /api on its own domain.
# Local dev: http://localhost:3001
VITE_API_URL=

# Operating Hours (24-hour format HH:mm)
VITE_PREORDER_START_TIME=10:00
VITE_OPENING_TIME=11:00
VITE_LAST_ORDER_TIME=21:30
VITE_CLOSING_TIME=22:00

# Admin Panel Credentials
# Access the admin panel at pizzapohoda.sk/admin. The Polish domain has no admin.
VITE_ADMIN_NAME=username
VITE_ADMIN_PASSWORD=password

# Company identifiers shown in the terms and the privacy policy.
# REQUIRED before the Polish site goes live — a Regulamin without them is not
# compliant with Polish consumer law.
VITE_COMPANY_ICO=
VITE_COMPANY_DIC=
VITE_COMPANY_IC_DPH=

# Analytics — one GA property per storefront. If the Polish one is left empty,
# Polish traffic lands in the Slovak property tagged with tenant=pl.
VITE_GA_ID_SK=G-6Q287KJ5RR
VITE_GA_ID_PL=
VITE_META_PIXEL_ID=695345926848903

RABBITMQ_USER=username
RABBITMQ_PASS=password
